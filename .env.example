# moalmanac-link configuration
#
# Copy to .env and edit. All variables use the MOALMANAC_LINK_ prefix.

# --- Server ---
MOALMANAC_LINK_HOST=127.0.0.1
MOALMANAC_LINK_ALLOW_PUBLIC_BIND=false
MOALMANAC_LINK_PORT=8000
# transport: unified | http | stdio
MOALMANAC_LINK_TRANSPORT=unified
MOALMANAC_LINK_MCP_PATH=/mcp
MOALMANAC_LINK_ALLOWED_HOSTS='["localhost","127.0.0.1","::1"]'
MOALMANAC_LINK_ALLOWED_ORIGINS='[]'
# Comma-separated list of allowed CORS origins (empty = none)
MOALMANAC_LINK_CORS_ORIGINS=
# log_level: DEBUG | INFO | WARNING | ERROR | CRITICAL
MOALMANAC_LINK_LOG_LEVEL=INFO
# log_format: json | console
MOALMANAC_LINK_LOG_FORMAT=console

